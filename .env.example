# .env.example - template for local settings shared by Docker and the Python backend.
#
# How to use:
#   Copy this file to ".env" in the repo root (same folder) and change values if needed.
#   .env is ignored by git - never commit it. Commit changes to THIS file instead
#   so teammates know a new setting exists.
#
# Used by:
#   docker-compose.yml          POSTGRES_* values create the database
#   backend/ (config.py)        DATABASE_URL and the BLE settings
#   frontend/ has its own frontend/.env.local (added in step F1)

# --- Database (TimescaleDB in Docker) ---
POSTGRES_USER=dryer
POSTGRES_PASSWORD=dryer_dev_password
POSTGRES_DB=dryer
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dryer:dryer_dev_password@localhost:5432/dryer

# --- Board / Bluetooth ---
# Name the board advertises (Bluefruit.setName in the firmware)
BLE_DEVICE_NAME=XIAO-BLE
# ID used for this board's rows in the database
DEVICE_ID=dryer-1
