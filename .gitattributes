# .gitattributes - keeps line endings consistent between Windows and Mac/Linux teammates.
# Text files are stored with LF in git, so diffs don't show every line as changed.
* text=auto
*.py text eol=lf
*.toml text eol=lf
uv.lock text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ino text eol=lf
.env.example text eol=lf
