# .env.local.example - settings template for the Next.js dashboard.
#
# How to use:
#   Copy this file to "frontend/.env.local" (same folder). .env.local is ignored by
#   git - never commit it. Commit changes to THIS file so teammates see new settings.
#   Restart `npm run dev` after changing .env.local.
#   On Vercel, the same names are set in Project Settings -> Environment Variables.
#
# Used by:
#   src/lib/db.ts        database connection
#   src/lib/auth.ts      login (only when DASHBOARD_PASSWORD is set)
#   src/lib/receiver.ts  "Connect to sensor" button
#
# These values are only read on the server. They are never sent to the browser.

# --- Database ---
# Local Docker database (default). For Timescale Cloud use its connection string,
# ending in ?sslmode=require, e.g. postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
DATABASE_URL=postgresql://dryer:dryer_dev_password@localhost:5432/dryer
# Which board's data to show (must match DEVICE_ID in the repo-root .env)
DEVICE_ID=dryer-1
# Connections per server copy. Default: 5 locally, 2 on Vercel.
# PG_POOL_MAX=5

# --- Login ---
# Leave DASHBOARD_PASSWORD unset for no login (local development).
# Set it (and AUTH_SECRET) to require a password - always on Vercel.
# AUTH_SECRET: a long random string, e.g. from:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing AUTH_SECRET (or the password, if AUTH_SECRET is unset) logs everyone out.
# DASHBOARD_PASSWORD=
# AUTH_SECRET=

# --- "Connect to sensor" button ---
# on / off. Unset = on locally, off on Vercel (Vercel can't run the Bluetooth receiver).
# RECEIVER_CONTROL=on
# Only needed if the defaults are wrong:
# BACKEND_DIR=../backend                       # where the Python receiver lives
# RECEIVER_PYTHON=../backend/.venv/Scripts/python.exe   # Windows; macOS/Linux: .venv/bin/python
